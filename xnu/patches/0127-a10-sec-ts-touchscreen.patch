@@
 bsd/dev/sweet_touch.c standard
+bsd/dev/sweet_touch_a10.c standard

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@
-	sweet_touch_init();
+	extern void a10_sec_touch_init(void);
+	a10_sec_touch_init();

diff --git a/bsd/dev/sweet_touch_a10.c b/bsd/dev/sweet_touch_a10.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_touch_a10.c
@@
+#include <sys/types.h>
+#include <sys/systm.h>
+
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+
+#include <mach/kern_return.h>
+#include <mach/machine_routines.h>
+#include <mach/vm_param.h>
+
+#include <stdint.h>
+#include <stdbool.h>
+
+/*
+ * Polled SEC_TS touch driver for A10 on Topaz.
+ * Assumes clocks, pinctrl, and regulators are already up.
+ */
+
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+#define A10_SEC_TS_I2C_BASE       0x13870000u
+#define A10_SEC_TS_I2C_SIZE       0x100u
+#define A10_SEC_TS_ADDRESS        0x48u
+
+#define SEC_TS_CMD_SENSE_ON       0x10u
+#define SEC_TS_CMD_SENSE_OFF      0x11u
+#define SEC_TS_READ_DEVICE_ID     0x22u
+#define SEC_TS_READ_PANEL_INFO    0x23u
+#define SEC_TS_READ_BOOT_STATUS   0x55u
+#define SEC_TS_READ_ONE_EVENT     0x60u
+#define SEC_TS_READ_ALL_EVENT     0x61u
+#define SEC_TS_CMD_CLEAR_EVENTS   0x62u
+
+#define SEC_TS_ACK_BOOT_COMPLETE  0x00u
+#define SEC_TS_STATUS_INFO        0x02u
+#define SEC_TS_STATUS_VENDOR_INFO 0x07u
+
+#define SEC_TS_EVENT_SIZE         8u
+#define SEC_TS_MAX_EVENTS         32u
+#define SEC_TS_MAX_CONTACTS       10u
+
+#define A10_SCREEN_WIDTH          720u
+#define A10_SCREEN_HEIGHT         1520u
+
+#define SEC_TS_RAW_MAX_X          4095u
+#define SEC_TS_RAW_MAX_Y          3541u
+
+#define IICCON                    0x00u
+#define IICSTAT                   0x04u
+#define IICADD                    0x08u
+#define IICDS                     0x0Cu
+#define IICLC                     0x10u
+#define IICINT                    0x20u
+
+#define IICCON_ACKEN              (1u << 7)
+#define IICCON_TXDIV_512          (1u << 6)
+#define IICCON_IRQEN              (1u << 5)
+#define IICCON_IRQPEND            (1u << 4)
+#define IICCON_SCALE(x)           ((x) & 0x0Fu)
+#define IICCON_BASE_CFG           (IICCON_ACKEN | IICCON_SCALE(0x0F))
+
+#define IICSTAT_MASTER_RX         (2u << 6)
+#define IICSTAT_MASTER_TX         (3u << 6)
+#define IICSTAT_START_BUSY        (1u << 5)
+#define IICSTAT_TXRXEN            (1u << 4)
+#define IICSTAT_LASTBIT           (1u << 0)
+
+#define SEC_TS_POLL_MS            8u
+#define SEC_TS_I2C_TIMEOUT_US     10000u
+#define SEC_TS_READY_RETRIES      100u
+
+struct sec_ts_state {
+    vm_offset_t regs;
+    bool started;
+    bool bus_ready;
+    bool logged_bus_error;
+    bool active[SEC_TS_MAX_CONTACTS];
+    int last_x[SEC_TS_MAX_CONTACTS];
+    int last_y[SEC_TS_MAX_CONTACTS];
+    uint32_t raw_max_x;
+    uint32_t raw_max_y;
+    uint8_t tx_count;
+    uint8_t rx_count;
+};
+
+static struct sec_ts_state sec_ts;
+
+static inline uint32_t i2c_rd(uint32_t off)
+{
+    return *(volatile uint32_t *)(sec_ts.regs + off);
+}
+
+static inline void i2c_wr(uint32_t off, uint32_t val)
+{
+    *(volatile uint32_t *)(sec_ts.regs + off) = val;
+}
+
+static void sleep_ms(uint32_t ms)
+{
+    assert_wait_timeout((event_t)&sec_ts, THREAD_UNINT, ms, 1000000u);
+    (void)thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void i2c_ack_irq(void)
+{
+    /* Flip to W1C (`| IICCON_IRQPEND`) if this Exynos block clears on 1 */
+    i2c_wr(IICCON, i2c_rd(IICCON) & ~IICCON_IRQPEND);
+}
+
+static void i2c_set_ack(bool en)
+{
+    uint32_t v = i2c_rd(IICCON);
+    i2c_wr(IICCON, en ? (v | IICCON_ACKEN) : (v & ~IICCON_ACKEN));
+}
+
+static bool i2c_wait_irq(void)
+{
+    uint32_t us;
+    for (us = 0; us < SEC_TS_I2C_TIMEOUT_US; us += 10u) {
+        if (i2c_rd(IICCON) & IICCON_IRQPEND)
+            return true;
+        delay(10);
+    }
+    return false;
+}
+
+static bool i2c_wait_idle(void)
+{
+    uint32_t us;
+    for (us = 0; us < SEC_TS_I2C_TIMEOUT_US; us += 10u) {
+        if ((i2c_rd(IICSTAT) & IICSTAT_START_BUSY) == 0)
+            return true;
+        delay(10);
+    }
+    return false;
+}
+
+static void i2c_stop(bool rx_mode)
+{
+    uint32_t dir = rx_mode ? IICSTAT_MASTER_RX : IICSTAT_MASTER_TX;
+
+    i2c_wr(IICSTAT, dir | IICSTAT_TXRXEN);
+    i2c_ack_irq();
+    delay(20);
+    (void)i2c_wait_idle();
+    i2c_wr(IICCON, IICCON_BASE_CFG);
+}
+
+static bool i2c_start(uint8_t addr, bool read, bool repeated)
+{
+    uint32_t dir = read ? IICSTAT_MASTER_RX : IICSTAT_MASTER_TX;
+
+    if (!repeated && !i2c_wait_idle())
+        return false;
+
+    i2c_wr(IICSTAT, dir | IICSTAT_TXRXEN);
+    i2c_wr(IICDS, ((uint32_t)addr << 1) | (read ? 1u : 0u));
+    i2c_wr(IICSTAT, dir | IICSTAT_START_BUSY | IICSTAT_TXRXEN);
+    if (repeated)
+        i2c_ack_irq();
+
+    if (!i2c_wait_irq())
+        return false;
+
+    return (i2c_rd(IICSTAT) & IICSTAT_LASTBIT) == 0;
+}
+
+static bool i2c_tx_byte(uint8_t b)
+{
+    i2c_wr(IICDS, b);
+    i2c_ack_irq();
+
+    if (!i2c_wait_irq())
+        return false;
+
+    return (i2c_rd(IICSTAT) & IICSTAT_LASTBIT) == 0;
+}
+
+static bool sec_i2c_write(uint8_t reg, const uint8_t *data, uint32_t len)
+{
+    uint32_t i;
+
+    if (!sec_ts.bus_ready || (len != 0 && data == NULL))
+        return false;
+
+    i2c_set_ack(true);
+    if (!i2c_start(A10_SEC_TS_ADDRESS, false, false))
+        goto out_err;
+    if (!i2c_tx_byte(reg))
+        goto out_err;
+
+    for (i = 0; i < len; i++) {
+        if (!i2c_tx_byte(data[i]))
+            goto out_err;
+    }
+
+    i2c_stop(false);
+    return true;
+
+out_err:
+    i2c_stop(false);
+    return false;
+}
+
+static bool sec_i2c_read(uint8_t reg, uint8_t *data, uint32_t len)
+{
+    uint32_t i;
+
+    if (!sec_ts.bus_ready || data == NULL || len == 0)
+        return false;
+
+    i2c_set_ack(true);
+    if (!i2c_start(A10_SEC_TS_ADDRESS, false, false))
+        goto err_tx;
+    if (!i2c_tx_byte(reg))
+        goto err_tx;
+
+    /* NACK the only byte up front so the slave doesn't hold SDA for a second byte */
+    i2c_set_ack(len > 1u);
+    if (!i2c_start(A10_SEC_TS_ADDRESS, true, true))
+        goto err_rx;
+
+    for (i = 0; i < len; i++) {
+        if (i + 1u == len)
+            i2c_set_ack(false);
+
+        i2c_ack_irq();
+        if (!i2c_wait_irq())
+            goto err_rx;
+
+        data[i] = (uint8_t)(i2c_rd(IICDS) & 0xFFu);
+    }
+
+    i2c_stop(true);
+    return true;
+
+err_tx:
+    i2c_stop(false);
+    return false;
+
+err_rx:
+    i2c_stop(true);
+    return false;
+}
+
+static int scale_axis(uint32_t raw, uint32_t raw_max, uint32_t out_max)
+{
+    if (raw_max == 0 || out_max == 0)
+        return 0;
+    if (raw > raw_max)
+        raw = raw_max;
+    return (int)((raw * out_max) / raw_max);
+}
+
+static void release_all_touches(void)
+{
+    unsigned int i;
+
+    for (i = 0; i < SEC_TS_MAX_CONTACTS; i++) {
+        if (!sec_ts.active[i])
+            continue;
+        sweet_hid_touch((int)i, 0, sec_ts.last_x[i], sec_ts.last_y[i]);
+        sec_ts.active[i] = false;
+    }
+}
+
+static void handle_event(const uint8_t ev[SEC_TS_EVENT_SIZE])
+{
+    uint8_t type = ev[0] & 0x03u;
+    uint8_t tid, action;
+    uint32_t rx, ry;
+    int x, y;
+    unsigned int slot;
+
+    if (type != 0u)
+        return;
+
+    tid = (ev[0] >> 2) & 0x0Fu;
+    action = (ev[0] >> 6) & 0x03u;
+    if (tid == 0 || tid > SEC_TS_MAX_CONTACTS)
+        return;
+
+    slot = (unsigned int)(tid - 1u);
+    rx = ((uint32_t)ev[1] << 4) | ((uint32_t)ev[3] & 0x0Fu);
+    ry = ((uint32_t)ev[2] << 4) | ((uint32_t)ev[3] >> 4);
+
+    x = scale_axis(rx, sec_ts.raw_max_x, A10_SCREEN_WIDTH - 1u);
+    y = scale_axis(ry, sec_ts.raw_max_y, A10_SCREEN_HEIGHT - 1u);
+
+    if (action == 1u || action == 2u) {
+        sweet_hid_touch((int)slot, 1, x, y);
+        sec_ts.active[slot] = true;
+        sec_ts.last_x[slot] = x;
+        sec_ts.last_y[slot] = y;
+    } else if (action == 3u && sec_ts.active[slot]) {
+        sweet_hid_touch((int)slot, 0, x, y);
+        sec_ts.active[slot] = false;
+        sec_ts.last_x[slot] = x;
+        sec_ts.last_y[slot] = y;
+    }
+}
+
+static bool poll_events(void)
+{
+    uint8_t buf[SEC_TS_MAX_EVENTS][SEC_TS_EVENT_SIZE];
+    uint8_t extra;
+    uint32_t i;
+
+    bzero(buf, sizeof(buf));
+    if (!sec_i2c_read(SEC_TS_READ_ONE_EVENT, buf[0], SEC_TS_EVENT_SIZE))
+        return false;
+
+    if (buf[0][0] == 0)
+        return true;
+
+    extra = buf[0][7] & 0x3Fu;
+    if (extra > SEC_TS_MAX_EVENTS - 1u) {
+        (void)sec_i2c_write(SEC_TS_CMD_CLEAR_EVENTS, NULL, 0);
+        release_all_touches();
+        return true;
+    }
+
+    if (extra != 0 &&
+        !sec_i2c_read(SEC_TS_READ_ALL_EVENT, &buf[1][0],
+                      (uint32_t)extra * SEC_TS_EVENT_SIZE))
+        return false;
+
+    for (i = 0; i <= extra; i++)
+        handle_event(buf[i]);
+
+    return true;
+}
+
+static bool wait_boot_ready(void)
+{
+    uint8_t ev[SEC_TS_EVENT_SIZE];
+    uint32_t tries;
+
+    for (tries = 0; tries < SEC_TS_READY_RETRIES; tries++) {
+        bzero(ev, sizeof(ev));
+        if (sec_i2c_read(SEC_TS_READ_ONE_EVENT, ev, sizeof(ev)) && ev[0] != 0) {
+            uint8_t id = ev[0] & 0x03u;
+            uint8_t sub = (ev[0] >> 2) & 0x0Fu;
+
+            if (id == 1u &&
+                (sub == SEC_TS_STATUS_INFO || sub == SEC_TS_STATUS_VENDOR_INFO) &&
+                ev[1] == SEC_TS_ACK_BOOT_COMPLETE)
+                return true;
+
+            handle_event(ev);
+        }
+        sleep_ms(20);
+    }
+
+    return false;
+}
+
+static bool read_panel_info(void)
+{
+    uint8_t dev_id[5] = { 0 };
+    uint8_t panel[11] = { 0 };
+
+    if (!sec_i2c_read(SEC_TS_READ_DEVICE_ID, dev_id, sizeof(dev_id)))
+        return false;
+    if (!sec_i2c_read(SEC_TS_READ_PANEL_INFO, panel, sizeof(panel)))
+        return false;
+
+    sec_ts.tx_count = panel[8];
+    sec_ts.rx_count = panel[9];
+    if (sec_ts.tx_count == 0 || sec_ts.rx_count == 0)
+        return false;
+
+    printf("a10_touch: id=%02x:%02x:%02x:%02x:%02x tx=%u rx=%u\n",
+           dev_id[0], dev_id[1], dev_id[2], dev_id[3], dev_id[4],
+           sec_ts.tx_count, sec_ts.rx_count);
+    return true;
+}
+
+static bool i2c_init_hw(void)
+{
+    if (sec_ts.regs == 0) {
+        sec_ts.regs = ml_io_map(A10_SEC_TS_I2C_BASE, A10_SEC_TS_I2C_SIZE);
+        if (sec_ts.regs == 0)
+            return false;
+    }
+
+    i2c_wr(IICSTAT, 0);
+    i2c_wr(IICCON, IICCON_BASE_CFG);
+    sec_ts.bus_ready = true;
+    return true;
+}
+
+static void sec_ts_thread(void *arg, wait_result_t wres)
+{
+    bool warned_map = false;
+    bool warned_boot = false;
+    unsigned int errs = 0;
+
+    (void)arg;
+    (void)wres;
+
+    sec_ts.raw_max_x = SEC_TS_RAW_MAX_X;
+    sec_ts.raw_max_y = SEC_TS_RAW_MAX_Y;
+
+    for (;;) {
+        if (!i2c_init_hw()) {
+            if (!warned_map) {
+                printf("a10_touch: ml_io_map failed\n");
+                warned_map = true;
+            }
+            sleep_ms(1000);
+            continue;
+        }
+
+        if (!wait_boot_ready()) {
+            if (!warned_boot) {
+                printf("a10_touch: timed out waiting for boot ack\n");
+                warned_boot = true;
+            }
+            sleep_ms(250);
+            continue;
+        }
+
+        if (!read_panel_info()) {
+            release_all_touches();
+            sleep_ms(250);
+            continue;
+        }
+
+        if (!sec_i2c_write(SEC_TS_CMD_SENSE_ON, NULL, 0)) {
+            printf("a10_touch: SENSE_ON failed\n");
+            sleep_ms(250);
+            continue;
+        }
+
+        printf("a10_touch: ready\n");
+        break;
+    }
+
+    for (;;) {
+        if (poll_events()) {
+            errs = 0;
+        } else {
+            errs++;
+            if (errs >= 3) {
+                release_all_touches();
+                if (!sec_ts.logged_bus_error) {
+                    printf("a10_touch: repeated i2c read errors\n");
+                    sec_ts.logged_bus_error = true;
+                }
+                sleep_ms(50);
+                continue;
+            }
+        }
+
+        sleep_ms(SEC_TS_POLL_MS);
+    }
+}
+
+void a10_sec_touch_init(void)
+{
+    thread_t th = THREAD_NULL;
+    kern_return_t kr;
+
+    if (sec_ts.started)
+        return;
+
+    sec_ts.started = true;
+    sec_ts.raw_max_x = SEC_TS_RAW_MAX_X;
+    sec_ts.raw_max_y = SEC_TS_RAW_MAX_Y;
+
+    kr = kernel_thread_start((thread_continue_t)sec_ts_thread, NULL, &th);
+    if (kr != KERN_SUCCESS) {
+        sec_ts.started = false;
+        printf("a10_touch: thread start failed (0x%x)\n", kr);
+        return;
+    }
+
+    thread_deallocate(th);
+}
